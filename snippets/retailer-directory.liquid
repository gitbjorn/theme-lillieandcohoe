{% doc %}
  Displays merchant-owned Retailer metaobjects with search and country filters.
  Existing page tables remain a fallback until the Retailer definition is available.
  @param {string} directory_id - Unique section identity for form labels and results.
  @example
  {% render 'retailer-directory', directory_id: section.id %}
{% enddoc %}

{% liquid
  assign use_metaobjects = false
  if metaobjects.retailer != blank
    assign use_metaobjects = true
  endif
%}

<div class="section section--page-width">
  <retailer-directory
    class="retailer-directory"
    data-source="{% if use_metaobjects %}metaobjects{% else %}tables{% endif %}"
    data-canada="{{ 'retailer_directory.canada' | t | escape }}"
    data-usa="{{ 'retailer_directory.usa' | t | escape }}"
    data-online="{{ 'retailer_directory.online' | t | escape }}"
    data-website="{{ 'retailer_directory.website' | t | escape }}"
    data-email="{{ 'retailer_directory.email' | t | escape }}"
    data-contact="{{ 'retailer_directory.contact' | t | escape }}"
    data-social="{{ 'retailer_directory.social' | t | escape }}"
    data-count-label="{{ 'retailer_directory.count' | t: count: '__COUNT__' | escape }}"
  >
    <header class="retailer-directory__header">
      <p class="retailer-directory__eyebrow">{{ 'retailer_directory.eyebrow' | t }}</p>
      <h1>{{ page.title | escape }}</h1>
      <p class="retailer-directory__intro">{{ 'retailer_directory.intro' | t }}</p>
      <p class="retailer-directory__note">{{ 'retailer_directory.note' | t }}</p>
    </header>

    <div class="retailer-directory__controls" ref="controls" hidden>
      <div class="retailer-directory__search">
        <label for="RetailerSearch-{{ directory_id }}">{{ 'retailer_directory.search_label' | t }}</label>
        <input
          id="RetailerSearch-{{ directory_id }}"
          type="search"
          placeholder="{{ 'retailer_directory.search_placeholder' | t | escape }}"
          ref="search"
          on:input="/search"
          aria-controls="RetailerResults-{{ directory_id }}"
        >
      </div>
      <fieldset class="retailer-directory__filters">
        <legend>{{ 'retailer_directory.browse' | t }}</legend>
        <div class="retailer-directory__filter-buttons">
          {% assign filters = 'all,CA,US,online' | split: ',' %}
          {% for filter in filters %}
            {% liquid
              case filter
                when 'all'
                  assign label_key = 'retailer_directory.all'
                when 'CA'
                  assign label_key = 'retailer_directory.canada'
                when 'US'
                  assign label_key = 'retailer_directory.usa'
                when 'online'
                  assign label_key = 'retailer_directory.online'
              endcase
            %}
            <button
              type="button"
              class="retailer-directory__filter"
              data-filter="{{ filter }}"
              ref="filters[]"
              on:click="/filter"
              aria-controls="RetailerResults-{{ directory_id }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ label_key | t }}
            </button>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    <div class="retailer-directory__results" ref="results" {% unless use_metaobjects %}hidden{% endunless %}>
      <div class="retailer-directory__summary">
        <p ref="status" role="status" aria-live="polite" aria-atomic="true"></p>
        <button type="button" class="button-unstyled retailer-directory__clear" ref="clear" on:click="/reset" hidden>
          {{ 'retailer_directory.clear' | t }}
        </button>
      </div>
      {% if use_metaobjects %}
        {% paginate metaobjects.retailer.values by 250 %}
          <ul id="RetailerResults-{{ directory_id }}" class="retailer-directory__grid" ref="grid" role="list">
            {% for retailer in metaobjects.retailer.values %}
              {% render 'retailer-card', retailer: retailer %}
            {% endfor %}
          </ul>
          {% if paginate.pages > 1 %}
            <div class="retailer-directory__pagination">{{ paginate | default_pagination }}</div>
          {% endif %}
        {% endpaginate %}
      {% else %}
        <ul id="RetailerResults-{{ directory_id }}" class="retailer-directory__grid" ref="grid" role="list"></ul>
      {% endif %}
      <div class="retailer-directory__empty" ref="empty" hidden>
        <h2 class="h3">{{ 'retailer_directory.empty_title' | t }}</h2>
        <p>{{ 'retailer_directory.empty_body' | t }}</p>
      </div>
    </div>

    <div class="retailer-directory__source rte" ref="source" {% if use_metaobjects %}hidden{% endif %}>
      {% unless use_metaobjects %}{{ page.content }}{% endunless %}
    </div>
  </retailer-directory>
</div>

<script src="{{ 'retailer-directory.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .retailer-directory {
    display: block;
    padding-block: clamp(40px, 6vw, 80px);
    min-width: 0;
    color: var(--color-foreground);
  }

  .retailer-directory [hidden] {
    display: none;
  }

  .retailer-directory__header {
    max-inline-size: 760px;
    margin-block-end: 40px;
  }

  .retailer-directory__eyebrow {
    margin-block: 0 16px;
    font-size: var(--font-size--xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .retailer-directory__header h1 {
    margin-block: 0 20px;
  }

  .retailer-directory__intro {
    font-size: 1.125rem;
    margin-block: 0 12px;
  }

  .retailer-directory__note {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-block: 0;
  }

  .retailer-directory__controls {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) auto;
    align-items: end;
    gap: 24px 40px;
    padding-block: 28px;
    border-block: 1px solid var(--color-border);
  }

  .retailer-directory__search label,
  .retailer-directory__filters legend {
    display: block;
    margin-block-end: 10px;
    font-size: 0.875rem;
  }

  .retailer-directory__search input {
    inline-size: 100%;
    min-block-size: 48px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .retailer-directory__filters {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .retailer-directory__filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .retailer-directory__filter {
    min-block-size: 48px;
    padding: 10px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-buttons-primary);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
  }

  .retailer-directory__filter[aria-pressed='true'] {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .retailer-directory__filter:hover {
    border-color: var(--color-foreground);
  }

  .retailer-directory__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 20px;
    font-size: 0.875rem;
  }

  .retailer-directory__summary p {
    margin: 0;
  }

  .retailer-directory__clear {
    min-block-size: var(--minimum-touch-target);
    text-decoration: underline;
    cursor: pointer;
  }

  .retailer-directory__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .retailer-directory__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2.5vw, 32px);
    border: 1px solid var(--color-border);
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .retailer-directory__location {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .retailer-directory__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .retailer-directory__address {
    margin: 0;
    font-style: normal;
    line-height: 1.65;
  }

  .retailer-directory__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-block-start: auto;
  }

  .retailer-directory__card a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--minimum-touch-target);
    color: inherit;
    text-underline-offset: 4px;
  }

  .retailer-directory__empty {
    padding: 48px 24px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .retailer-directory__source {
    overflow-x: auto;
  }

  .retailer-directory__source .wp-block-spacer,
  .retailer-directory__source h1 {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .retailer-directory__controls {
      grid-template-columns: 1fr;
    }

    .retailer-directory__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 599px) {
    .retailer-directory__grid {
      grid-template-columns: 1fr;
    }

    .retailer-directory__filter-buttons {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .retailer-directory__filter {
      padding-inline: 16px;
    }
  }
{% endstylesheet %}
